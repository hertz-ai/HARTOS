# HevolveBot Environment Variables
# Copy to .env and fill in values

# REQUIRED: Master key for secrets vault encryption
HEVOLVE_MASTER_KEY=your-strong-master-key-here

# API key for authenticating requests to core endpoints
HEVOLVE_API_KEY=

# LLM Provider Keys (alternatively stored in encrypted vault)
OPENAI_API_KEY=
GROQ_API_KEY=
# GLM 5.2 (Zhipu / Z.ai) — OpenAI-compatible cloud model. ZHIPUAI_API_KEY is
# accepted as a fallback. Optional: GLM_BASE_URL overrides the default
# https://api.z.ai/api/paas/v4 (use https://open.bigmodel.cn/api/paas/v4 for
# mainland China); GLM_MODEL overrides the model string (default glm-5.2).
GLM_API_KEY=
LANGCHAIN_API_KEY=

# Search & External APIs
GOOGLE_CSE_ID=
GOOGLE_API_KEY=
NEWS_API_KEY=
SERPAPI_API_KEY=

# Memory Service
ZEP_API_KEY=

# Social Platform JWT Secret (REQUIRED - no default allowed)
SOCIAL_SECRET_KEY=

# Database (PostgreSQL recommended for production)
DATABASE_URL=postgresql://user:pass@localhost/hevolve

# Database encryption key (for SQLite/SQLCipher)
SOCIAL_DB_KEY=

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_RATE_LIMIT_URL=redis://localhost:6379/1

# TLS Configuration
TLS_CERT_PATH=
TLS_KEY_PATH=
HEVOLVE_CA_BUNDLE=

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Environment: development | production
HEVOLVE_ENV=development

# MCP Server Allowlist (comma-separated hostnames)
MCP_ALLOWED_SERVERS=localhost

# Deployment Integrity (dev defaults - override for production)
HEVOLVE_DEV_MODE=true
HEVOLVE_ENFORCEMENT_MODE=off

# ── Durable state ─────────────────────────────────────────────────────
# Where anything that must outlive the process is written: the marketing
# funnel (marketing_clicks.jsonl), and anything else going through
# core.platform_paths.get_data_dir().
#
# Read FIRST by get_data_dir(), ahead of HARTOS_DATA_DIR and the platform
# default. The default inside the Docker image is /root/.config/nunba, which
# is the container's writable layer, so it is destroyed on every rebuild. That
# is not hypothetical: the 2026-08-18 rebuild took the funnel from 29 recorded
# events to 0. Channel attribution cannot be reconstructed afterwards.
#
# In Docker this is already set to /app/data by the Dockerfile. Bind it to
# something real on the host or it is still ephemeral:
#   -v /opt/hzai-LLM-Langchain-Chatbot-Agent/data:/app/data
NUNBA_DATA_DIR=
