# HART OS boot splash (Plymouth `script` plugin — framebuffer/KMS, no GL, so it
# is safe on the broken-GPU / software-GL path the rest of the OS hardens for).
# Minimal + standard: dark HART background, centered logo, LUKS message/password
# support. Opt-in via hart.bootSplash.customTheme (default off → stock + logo).

# Dark HART background gradient.
Window.SetBackgroundTopColor(0.031, 0.039, 0.071);
Window.SetBackgroundBottomColor(0.050, 0.070, 0.120);

# Centered logo.
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2;
logo.sprite.SetX(logo.x);
logo.sprite.SetY(logo.y);
logo.sprite.SetZ(100);

# Status/message line (LUKS prompt, fsck, etc.) below the logo.
message_sprite = Sprite();
message_sprite.SetPosition(logo.x, logo.y + logo.image.GetHeight() + 24, 200);

fun message_callback(text) {
  message_sprite.SetImage(Image.Text(text, 0.0, 0.83, 0.67));  # HART teal
}
Plymouth.SetMessageFunction(message_callback);

fun display_password_callback(prompt, bullets) {
  message_sprite.SetImage(Image.Text(prompt + "  " + bullets, 0.9, 0.9, 0.9));
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);
