[Unit]
Description=HART OS Backend (Flask over Hypercorn/ASGI)
Documentation=https://github.com/hertz-ai/HARTOS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hart
Group=hart
WorkingDirectory=/opt/hart
# Serves asgi:application, not hart_intelligence_entry:app.
#
# waitress is pure WSGI and has no websocket support, so the previous
# ExecStart served HTTP correctly and silently dropped ws://<node>/peer_link --
# PeerLink.accept() never fired and PeerLinkManager._links stayed empty for
# skill broadcast, _publish_via_peer_link and collect() shard fan-out. waitress
# is in this stack because it is the only WSGI server that runs on Windows
# (where the Nunba desktop lives); on Linux it had no platform justification.
#
# asgi:application is peer_link_asgi(AsyncioWSGIMiddleware(app)) built by the
# canonical core.serve.build_asgi_app. It does NOT run main(), so boot
# integrity checks, guardrail hash enforcement, the EventBus, Crossbar
# subscribers and the agent daemon supervisor are unchanged by this line --
# enabling those is a separate decision (see asgi.py).
#
# If hypercorn or its h2/wsproto subtree is missing, this fails to start rather
# than degrading to a peer-invisible server. That is intended.
ExecStart=/opt/hart/venv/bin/python -m hypercorn asgi:application --bind 0.0.0.0:${HARTOS_BACKEND_PORT:-6777} --keep-alive 120
EnvironmentFile=/etc/hart/hart.env
Restart=on-failure
RestartSec=5
StartLimitBurst=3
StartLimitIntervalSec=60
WatchdogSec=120
TimeoutStartSec=30
TimeoutStopSec=15

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/hart /var/log/hart /var/lib/hart/agent_data
PrivateTmp=yes

ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
MemoryDenyWriteExecute=no
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hart-backend

[Install]
WantedBy=hart.target
