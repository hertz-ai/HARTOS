# Production Dockerfile for HARTOS — gunicorn/WSGI variant
#
# WHAT THIS IS
#   A gunicorn-fronted image for cloud deployment.  Also used by
#   deploy/distributed/docker-compose.distributed.yml, which builds from this
#   file, so both inherit everything below.
#
# WHAT THIS IS NOT
#   It is NOT the only way HARTOS is served, and as of 2026-08-19 it is NOT
#   what the live central node runs.  Central (192.168.0.9) runs container
#   `langchain` with the ROOT ./Dockerfile CMD -- `python
#   hart_intelligence_entry.py` on port 6777.  Do not read this file as a
#   description of production; check the box.
#
# TWO CONSEQUENCES OF SERVING `hart_intelligence_entry:app` (read before use)
#
#   1. main() NEVER RUNS.  gunicorn imports the module-level Flask `app`
#      (hart_intelligence_entry.py:869) directly.  main() is reached only via
#      `if __name__ == '__main__'` at the bottom of that file, so every boot
#      step it performs is SKIPPED here: hevolve_verify_boot(), guardrail
#      hash enforcement, _validate_startup(), EventBus bootstrap, local
#      Crossbar subscribers, runtime-tools restoration, the HART skill
#      registry, and the agent-engine daemon supervisor + Phase-2 goal
#      bootstrap.  The root ./Dockerfile (`python hart_intelligence_entry.py`)
#      runs all of them.  If you need the agentic runtime, use that CMD.
#
#   2. NO WEBSOCKETS.  `--worker-class gevent` serves a plain WSGI app, and
#      WSGI cannot represent a websocket scope.  So ws://<node>/peer_link is
#      unavailable here -- not merely unmounted but unservable -- and
#      PeerLink.accept() can never fire, which leaves PeerLinkManager._links
#      empty for skill broadcast, claude_hive_session._publish_via_peer_link
#      and collect() shard fan-out.  core/peer_link/server.py mounts the
#      listener on the hypercorn path only.  Note that
#      core.peer_link.server.peer_link_enabled() reads only
#      HEVOLVE_PEER_LINK_SERVER, so it still reports True here even though the
#      capability is absent -- do not use it as proof a node accepts peers.
#      Switching to an ASGI worker (uvicorn) or hypercorn is what would give
#      this image websockets; a wrapper cannot.
#
# Optimized for cloud deployment with gunicorn

# Multi-arch build args (docker buildx)
ARG TARGETPLATFORM
ARG BUILDPLATFORM

# Build stage for dependencies
FROM --platform=$BUILDPLATFORM python:3.11-slim as builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for layer caching
COPY requirements.txt .
COPY agent-ledger-opensource/ ./agent-ledger-opensource/

# Create virtual environment and install dependencies
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --upgrade pip wheel setuptools && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir ./agent-ledger-opensource && \
    pip install --no-cache-dir \
        gunicorn[gevent]==21.2.0 \
        gevent==23.9.1 \
        autogen-agentchat==0.2.37 \
        apscheduler \
        autobahn==23.1.2 \
        autobahn[serialization] \
        autobahn[twisted] \
        json-repair \
        mysql-connector-python \
        redis[hiredis]

# Production stage
FROM python:3.11-slim as production

# Labels for container metadata
LABEL maintainer="HARTOS Team"
LABEL version="1.0.0"
LABEL description="Production build of HARTOS"
LABEL org.opencontainers.image.platforms="linux/amd64,linux/arm64"

# Create non-root user for security
RUN groupadd -r appgroup && useradd -r -g appgroup appuser

WORKDIR /app

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libmariadb3 \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy application code
COPY hart_intelligence_entry.py .
# config.json deliberately excluded — use env vars or Docker secrets for API keys
# COPY config.json .  # SECURITY: never bake credentials into image layers
COPY helper.py .
COPY threadlocal.py .
COPY reuse_recipe.py .
COPY create_recipe.py .
COPY cultural_wisdom.py .
COPY lifecycle_hooks.py .
COPY helper_ledger.py .
COPY exception_collector.py .
COPY gather_agentdetails.py .
COPY recipe_experience.py .

# Copy core modules
COPY core/ ./core/

# Copy integrations (social and other essential modules)
COPY integrations/ ./integrations/

# Copy agent-ledger package
COPY agent-ledger-opensource/ ./agent-ledger-opensource/

# Copy prompts
COPY prompts/ ./prompts/

# Copy security module
COPY security/ ./security/

# Copy build scripts (needed for hevolveai compilation)
COPY scripts/ ./scripts/

# Create placeholder release manifest (CI/CD pipeline overwrites with signed version)
RUN echo '{"version": "dev", "signed": false}' > release_manifest.json

# Create necessary directories
RUN mkdir -p /app/logs /app/media /app/output_images /app/agent_data

# ── HevolveAI source protection (zero loopholes) ──
# HevolveAI is NEVER shipped as Python source or .pyc in the Docker image.
# It ships ONLY as an encrypted native binary (.so.enc) decrypted to tmpfs at runtime.
RUN \
    # Remove ALL HevolveAI Python source and bytecode from the image
    find /opt/venv/lib -path '*/hevolveai*' -delete 2>/dev/null || true && \
    find /opt/venv/lib -path '*/embodied_ai*' -delete 2>/dev/null || true && \
    # Remove dist-info (leaks package metadata, git origin, file listing)
    find /opt/venv/lib -path '*/hevolveai*dist-info' -type d -exec rm -rf {} + 2>/dev/null || true && \
    find /opt/venv/lib -path '*/embodied*dist-info' -type d -exec rm -rf {} + 2>/dev/null || true && \
    # Remove build scripts from final image
    rm -rf /app/scripts && \
    # Verify: no hevolveai Python files remain
    test -z "$(find /opt/venv/lib -name '*.py' -path '*hevolveai*' 2>/dev/null)" || \
      (echo "ERROR: HevolveAI source still in image" && exit 1)
# HevolveAI loads at runtime via security/native_hive_loader.py:
#   1. Finds .so.enc at /usr/lib/hevolve/ or ~/.hevolve/lib/
#   2. Decrypts to tmpfs (RAM only) using HKDF(node_key + master_pubkey)
#   3. Loads via ctypes, wipes tmpfs
#   4. Falls back to stub mode if binary not present

# DEPLOYMENT: Run with read-only filesystem to prevent runtime code modification:
#   docker run --read-only --tmpfs /tmp --tmpfs /app/logs --tmpfs /app/agent_data ...

# Create log file
RUN touch /app/langchain.log

# Set proper permissions
RUN chown -R appuser:appgroup /app

# Switch to non-root user
USER appuser

# ── LiveKit SFU intentionally NOT staged in this image ──
# This is the *central* HARTOS image — sync / federation / backup-restore
# only.  Voice/video calls run on regional or flat HARTOS nodes that DO
# host an SFU (their image is built from the top-level Dockerfile, which
# pre-stages livekit-server in Layer 4).  HEVOLVE_DEPLOY_MODE=central
# below makes integrations.social.livekit_supervisor.supervisor_should_run()
# return False, so no one tries to spawn a missing binary at startup.
# Operators that override this for a hybrid deployment must mount the
# binary at /usr/local/bin/livekit-server or set LIVEKIT_BINARY_PATH.

# Environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    FLASK_ENV=production \
    DOCKER_CONTAINER=true \
    WORKERS=4 \
    THREADS=2 \
    TIMEOUT=120 \
    HEVOLVE_ENFORCEMENT_MODE=hard \
    HEVOLVE_DEPLOY_MODE=central \
    LIVEKIT_DISABLE=1

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run with gunicorn.  This imports `app` directly, so main() does not run and
# there are no websockets (no /peer_link).  See the header of this file before
# assuming this is how production boots -- the root ./Dockerfile serves the
# same app through main() + hypercorn and does have both.
CMD ["sh", "-c", "gunicorn --bind 0.0.0.0:8000 --workers ${WORKERS} --threads ${THREADS} --timeout ${TIMEOUT} --worker-class gevent --access-logfile - --error-logfile - --capture-output hart_intelligence_entry:app"]
