{
  "about": [
    "One grammar for the language marks in a spoken reply, shared by two repos.",
    "This file is byte-for-byte the same in HARTOS and in Nunba-HART-Companion (tests/fixtures/speech_tags_cases.json); a test in each repo pins its sha256, so a change here is made in both or fails in one.",
    "HARTOS (integrations/channels/media/tts_text_normalizer.py) is checked on 'shown' and 'whole_language'; Nunba (tts/language_segmenter.py) on 'segments'.",
    "input: what the model wrote. language: the language the caller asked to hear.",
    "shown: the text a person reads (no mark, words kept).",
    "segments: [language, kind, text] in order, as the speaker gets them; language is null for a sound part with no mark.",
    "whole_language: the one language every word is marked with, else null.",
    "bare_codes: every code that is a language mark when written bare, as <es>."
  ],
  "bare_codes": [
    "ar", "as", "bg", "bn", "brx", "cy", "de", "doi", "el", "en", "es", "fa", "fi", "fr", "gu", "he", "hi", "hu",
    "id", "is", "it", "ja", "km", "kn", "ko", "kok", "ks", "lo", "lv", "mai", "ml", "mni", "mr", "ms", "my", "ne",
    "nl", "or", "pa", "pl", "pt", "ro", "ru", "sa", "sat", "sd", "si", "sr", "sv", "sw", "ta", "te", "th", "tr",
    "uk", "ur", "vi", "zh"
  ],
  "cases": [
    {
      "name": "a bare code marks a part",
      "input": "Hi there. <es>Hola amigo</es> Bye now.",
      "language": "en",
      "shown": "Hi there. Hola amigo Bye now.",
      "segments": [["en", "speech", "Hi there."], ["es", "speech", "Hola amigo"], ["en", "speech", "Bye now."]],
      "whole_language": null
    },
    {
      "name": "a code with a region",
      "input": "<pt-BR>Olá, tudo bem?</pt-BR>",
      "language": "en",
      "shown": "Olá, tudo bem?",
      "segments": [["pt-BR", "speech", "Olá, tudo bem?"]],
      "whole_language": "pt-BR"
    },
    {
      "name": "the lang form with a space",
      "input": "<lang es>Hola</lang> friend",
      "language": "en",
      "shown": "Hola friend",
      "segments": [["es", "speech", "Hola"], ["en", "speech", "friend"]],
      "whole_language": null
    },
    {
      "name": "the lang form with double quotes",
      "input": "<lang=\"es\">Buenos días</lang>",
      "language": "en",
      "shown": "Buenos días",
      "segments": [["es", "speech", "Buenos días"]],
      "whole_language": "es"
    },
    {
      "name": "the lang form after the quote marks were cut for speech",
      "input": "<lang=es>Buenos días</lang>",
      "language": "en",
      "shown": "Buenos días",
      "segments": [["es", "speech", "Buenos días"]],
      "whole_language": "es"
    },
    {
      "name": "the lang form with single quotes",
      "input": "<lang='fr'>Bonjour Zoey</lang>",
      "language": "en",
      "shown": "Bonjour Zoey",
      "segments": [["fr", "speech", "Bonjour Zoey"]],
      "whole_language": "fr"
    },
    {
      "name": "the lang form in capitals",
      "input": "<LANG ES>Hola</LANG>",
      "language": "en",
      "shown": "Hola",
      "segments": [["es", "speech", "Hola"]],
      "whole_language": "es"
    },
    {
      "name": "one form opens and the other closes",
      "input": "<lang es>Hola</es> and <fr>salut</lang> friend",
      "language": "en",
      "shown": "Hola and salut friend",
      "segments": [["es", "speech", "Hola"], ["en", "speech", "and"], ["fr", "speech", "salut"], ["en", "speech", "friend"]],
      "whole_language": null
    },
    {
      "name": "a whole reply in another language is wrapped once",
      "input": "<fr>Bonjour Zoey, comment ça va ?</fr>",
      "language": "en",
      "shown": "Bonjour Zoey, comment ça va ?",
      "segments": [["fr", "speech", "Bonjour Zoey, comment ça va ?"]],
      "whole_language": "fr"
    },
    {
      "name": "a marked part in the Latin alphabet is spoken as its language",
      "input": "<hi>namaste dost</hi> said Ravi.",
      "language": "en",
      "shown": "namaste dost said Ravi.",
      "segments": [["hi", "speech", "namaste dost"], ["en", "speech", "said Ravi."]],
      "whole_language": null
    },
    {
      "name": "Japanese and Chinese share characters and the mark tells them apart",
