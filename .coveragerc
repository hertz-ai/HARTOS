[run]
# STOP ENUMERATING. `source = .` with the omit list below doing the excluding,
# so new code is measured BY DEFAULT and exclusion is the deliberate act.
#
# core/ was missing from the old hand-written list until 2026-07-31, so the
# package holding the canonical single-sources — constants.py
# (LATENCY_BUDGETS), subprocess_safe.py (the one bounded probe, 139 callers),
# port_registry, llama_scheduler, platform/, peer_link/ — reported no coverage
# at all. Not LOW coverage: NO DATA, which reads identically to "nothing to
# see" on a report, and is how the gap stayed invisible.
#
# Adding `core` fixed that one entry and left the MECHANISM in place. Counted
# against what actually exists, the list still reached 5 of 25 integrations
# subpackages, and missed two whole top-level packages (desktop/, hart_sdk/)
# that both have __init__.py. Invisible: remote_desktop, internal_comm, mcp,
# expert_agents, google_a2a, ap2, gateway, providers, openclaw, audio,
# marketing, browser_research, distributed_agent, agent_lightning and more —
# several of which the parity matrix cites, and any of which would answer a
# "which tests cover this?" query with a confident EMPTY set.
#
# The next package added would have been invisible the same way `core` was.
# This inverts the failure mode from "silently absent" to "explicitly
# excluded" — the same fail-toward-visible principle as `unclaimed=True` in
# the device panel.
source =
    .
data_file = test-reports/coverage/.coverage

# Record WHICH TEST executed each line. This answers "what tests exercise
# shell_system_apis.py?" — the question whose absence let a regression ship
# on 2026-07-31: `_run` was changed in shell_system_apis.py, but the suite
# that caught it is named test_shell_os_apis.py (WiFi/VPN routes live in the
# former, are tested from the latter), so the obvious "run the same-named
# test file" reflex missed it entirely.
#
# With contexts recorded, the impacted-test set is derivable from coverage
# data instead of guessed from filenames. `coverage report` has no context
# flag (only `coverage html --show-contexts` does), so to answer it directly:
#
#   python -c "import coverage; d=coverage.CoverageData('test-reports/coverage/.coverage'); \
#     d.read(); f=[x for x in d.measured_files() if 'shell_system_apis' in x][0]; \
#     print(sorted({c for c in d.contexts_by_lineno(f).values() for c in c if c}))"
#
# ...which lists every test that executed a line of that file. Verified
# working 2026-07-31 (23 contexts recorded); do not swap in a flag that
# does not exist.
dynamic_context = test_function

# With `source = .` these carry the whole exclusion job, so they are now
# load-bearing rather than incidental. Anything not listed here IS measured.
omit =
    tests/*
    venv*/*
    .venv*/*
    .idea/*
    autogen-*/*
    docs/*
    */migrations/*
    */__pycache__/*
    # Added with `source = .`: these were previously excluded by simply not
    # being enumerated, and would otherwise become newly-measured noise.
    setup.py
    conftest.py
    */conftest.py
    build/*
    dist/*
    *.egg-info/*
    node_modules/*
    nixos/*
    scripts/*
    .github/*
    # Runtime-generated temp modules some tests write at CWD (e.g. config-3.py):
    # never real source, and they break combine on a fresh checkout (see the
    # [report] ignore_errors note). Omit so they never enter the data.
    config-*.py

[report]
show_missing = true
precision = 1
fail_under = 0
# A combined data set can reference a file that existed only at run time — e.g.
# a test writes a temp `config-3.py` at CWD, coverage records it, then the
# combine job runs on a FRESH checkout where that file is gone. Without this,
# `coverage report`/`coverage json` raise "No source for code: config-3.py"
# and abort → the Coverage Baseline combine step produced NO coverage.json and,
# because every command there was `|| true`, the job still went GREEN with no
# baseline (run 33305338230). ignore_errors skips the vanished source instead
# of aborting the whole report; the phantom is also omitted below so it never
# enters the data in the first place.
ignore_errors = true
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__
    raise NotImplementedError
    pass
    except ImportError
    except Exception

[html]
directory = test-reports/coverage
title = HART OS Code Coverage Report
